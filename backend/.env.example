# Application
ENV=local
DEBUG=true
APP_NAME=ePass API
APP_VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://epass:epass123@localhost:5432/epass
DATABASE_URL_SYNC=postgresql://epass:epass123@localhost:5432/epass

# JWT
JWT_SECRET=change-me-in-production-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:8081"]

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=epass-uploads

# Sentry
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=100/minute
