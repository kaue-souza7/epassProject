# Application
ENV=local
DEBUG=true
APP_NAME=ePass API
APP_VERSION=0.1.0

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql+asyncpg://epass:epass123@localhost:5432/epass
DATABASE_URL_SYNC=postgresql://epass:epass123@localhost:5432/epass

# JWT
JWT_SECRET=change-me-in-production-jwt-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:8081"]

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
S3_BUCKET=epass-uploads

# Sentry
SENTRY_DSN=

# SMTP
# A configuração real é feita no painel (Admin > Config. Acacêmicas) e vale
# mais que estas variáveis, que só servem de valor inicial. Os dois modos de
# TLS são mutuamente exclusivos: STARTTLS na 587, TLS implícito na 465.
#   Gmail/Outlook exigem senha de aplicativo (2 etapas ativa), não a senha da conta.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
# Desligar só para servidor on-premise com certificado self-signed — a senha
# do SMTP passa a trafegar sem garantia de integridade.
SMTP_VERIFY_SSL=true

# Rate Limiting
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=100/minute
AI_RATE_LIMIT=20/minute

# ---------------------------------------------------------------------------
# Assistente de IA local "Atena" (Ollama)
# ---------------------------------------------------------------------------
# Liga/desliga o assistente. Com false, o SGE inteiro continua funcionando e
# o /ai/chat responde que a IA está desabilitada.
AI_ENABLED=true

# Dentro do Compose é http://ollama:11434. Para usar o Ollama NATIVO no Mac
# (aceleração Metal, bem mais rápido), suba no host e aponte para:
#   OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=qwen3:4b

# Resiliência. O assistente é acessório: uma falha dele NUNCA derruba o SGE.
OLLAMA_CONNECT_TIMEOUT=3.0
OLLAMA_HEALTH_TIMEOUT=3.0
OLLAMA_TIMEOUT=120
OLLAMA_RETRY_ATTEMPTS=2
OLLAMA_RETRY_BACKOFF=0.5
OLLAMA_CIRCUIT_FAILURES=5
OLLAMA_CIRCUIT_RESET_SECONDS=60
OLLAMA_MAX_CONCURRENCY=1

# Streaming (SSE). São dois prazos diferentes de propósito:
#  - FIRST_TOKEN: espera pelo primeiro token, que é quando o Ollama carrega o
#    modelo em RAM. Medido em produção: ~56s na primeira pergunta depois de o
#    container subir, ~6s com o modelo já carregado.
#  - READ: tempo máximo de silêncio ENTRE tokens depois que a resposta começou.
OLLAMA_STREAM_FIRST_TOKEN_TIMEOUT=120.0
OLLAMA_STREAM_READ_TIMEOUT=30.0

# Parâmetros de inferência. OLLAMA_THINK=false desliga o modo raciocínio do
# Qwen3 (ligado, uma pergunta simples leva minutos em CPU).
OLLAMA_THINK=false
OLLAMA_NUM_CTX=4096
OLLAMA_TEMPERATURE=0.2
OLLAMA_TOP_P=0.9
OLLAMA_REPEAT_PENALTY=1.1
OLLAMA_MAX_TOKENS=400

# Teto de caracteres do contexto autorizado enviado ao modelo.
AI_CONTEXT_MAX_CHARS=4000

# --- Histórico de conversas ---
# Quantos turnos (pergunta+resposta) vão no prompt. 0 desliga o histórico:
# cada pergunta passa a ser independente. Baixo de propósito — o modelo é
# pequeno e o histórico é DADO NÃO CONFIÁVEL: ele nunca amplia o que a
# pergunta pode perguntar.
AI_HISTORY_TURNS=3
AI_HISTORY_MAX_CHARS=1200
AI_HISTORY_LIST_LIMIT=50

# --- Cota de uso do assistente ---
# Perguntas por USUÁRIO autenticado por minuto (a chave é o `sub` do JWT, não o
# IP: atrás de proxy reverso todo mundo compartilha o mesmo endereço, e limitar
# por IP puniria os usuários honestos que dividem a rede com quem_abusa).
# Vale para /ai/chat e /ai/chat/stream. A cota padrão da API continua valendo
# nos demais endpoints (ver RATE_LIMIT_*).
AI_RATE_LIMIT=20/minute
