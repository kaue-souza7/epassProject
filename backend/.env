ENV=local
DEBUG=true
APP_NAME=ePass API
APP_VERSION=0.1.0
HOST=0.0.0.0
PORT=8000
DATABASE_URL=postgresql+asyncpg://epass:epass123@localhost:5432/epass
DATABASE_URL_SYNC=postgresql://epass:epass123@localhost:5432/epass
JWT_SECRET=local-dev-jwt-secret-key-not-for-production
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://localhost:8081","http://192.168.15.34:5173"]
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./storage
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=100/minute
